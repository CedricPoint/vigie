# Port the web server listens on.
PORT=3000

# Admin password. Leave empty to choose it in the browser on first visit (/setup).
ADMIN_PASSWORD=

# Where monitors and history are stored (two JSON files).
DATA_DIR=./data

# Language used on first start: en or fr. Can be changed later in Settings.
VIGIE_LANG=en

# Reverse proxies to trust for the client IP (login rate limiting).
# Default: loopback and private networks. Use a number of hops, "true", or a list of IPs.
# TRUST_PROXY=1
